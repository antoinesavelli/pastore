# Text for ~/.config/systemd/user/pastore-gateway.service (R20, R33). Not installed by the repo: the cutover fix
# a private script installs it.
[Unit]
Description=pastore gateway: the Ollama front door on :11434, priority by source (forwards to Ollama on 127.0.0.1:11435)
Documentation=file:/srv/projects/pastore/docs/STATUS.md
StartLimitIntervalSec=60
StartLimitBurst=10
OnFailure=unit-failed@%n.service

[Service]
Type=simple
WorkingDirectory=/srv/projects/pastore
ExecStart=/srv/projects/pastore/.venv/bin/python -m pastore.gateway --policy /srv/projects/pastore/policy.yaml --host 0.0.0.0 --port 11434
Restart=always
RestartSec=1
MemoryMax=2G
MemorySwapMax=0

[Install]
WantedBy=default.target
