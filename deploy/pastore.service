# Template for ~/.config/systemd/user/pastore.service (the dispatcher). Copy it, check that the checkout is at
# ~/pastore (otherwise edit WorkingDirectory= and ExecStart=), then `systemctl --user daemon-reload`.
# Not installed by the repo.
[Unit]
Description=pastore dispatcher: runs the jobs listed in policy.yaml on the GPU hosts
Documentation=file:%h/pastore/docs/DESIGN.md
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/pastore
ExecStart=%h/pastore/.venv/bin/python -m pastore start
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
