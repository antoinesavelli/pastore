# Template for ~/.config/systemd/user/pastore-executor-link.service (R26): the workstation's 127.0.0.1:11436 forwards
# to the second host's Ollama on its own 127.0.0.1:11434 through the SSH alias `second-host` (~/.ssh/config). No
# network change on the second host. It never gives up: while the second host is away the dispatcher reads
# `executor-down` from the dead port (R27), and the link comes back on its own. Not installed by the repo.
[Unit]
Description=pastore executor link: SSH forward 127.0.0.1:11436 to the second host's Ollama on 127.0.0.1:11434
Documentation=file:%h/pastore/docs/DESIGN.md
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=10 -o ServerAliveCountMax=3 -o ConnectTimeout=10 -o ControlMaster=no -o ControlPath=none -L 127.0.0.1:11436:127.0.0.1:11434 second-host
Restart=always
RestartSec=10
MemoryMax=64M
MemorySwapMax=0

[Install]
WantedBy=default.target
